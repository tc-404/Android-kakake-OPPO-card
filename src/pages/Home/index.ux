<!--
  应用入口页（保留最小页面以满足快应用必须有入口的要求）
  展示卡片说明与内置连接地址，不做轮询。
  真正的功能在桌面 4x2 卡片上。
-->

<template>
  <div class="page">
    <div class="card">
      <text class="title">kakake远程监控</text>
      <text class="desc">请到桌面添加「kakake远程监控」卡片查看实时状态。</text>

      <div class="row" for="{{ eps }}">
        <div class="dot"></div>
        <text class="addr">{{ $item.name }} · {{ $item.ip }}:{{ $item.port }}</text>
      </div>

      <text class="tip">修改地址：编辑 连接配置.json 后运行「构建」脚本。</text>
    </div>
  </div>
</template>

<script>
import { ENDPOINTS } from '../../common/endpoints.js'

export default {
  private: {
    eps: []
  },
  onInit() {
    this.eps = (ENDPOINTS || []).map((c) => {
      return { name: c.name || '连接', ip: c.ip, port: c.port || '8787' }
    })
  }
}
</script>

